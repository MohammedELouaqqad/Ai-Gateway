# Copier vers .env et remplir (ne jamais committer .env)
OPENAI_API_KEY=sk-proj-your-key-here

# Keycloak — issuer du realm (doit matcher le claim "iss" du JWT)
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/Ai-Gateway

# CORS frontend Vite
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Local : laisser vide ou "dev". Déploiement : SPRING_PROFILES_ACTIVE=prod
# SPRING_PROFILES_ACTIVE=prod
# APP_SEED_ENABLED=false
