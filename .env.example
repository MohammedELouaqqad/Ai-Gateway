# Root-level credentials for docker-compose.yml — REQUIRED, no weak fallback.
# docker compose reads a `.env` file in this directory automatically.
#
# `docker compose up` refuses to start without every one of these set — no default,
# no fallback anywhere in docker-compose.yml (${VAR:?} for all of them). A missing OR
# blank var used to silently fall back to postgres/postgres, admin/admin, ... not anymore.
#
# This file is the template committed to the repo. Copy it to `.env` first, THEN fill in
# every value yourself:
#   cp .env.example .env
#
# `.env` is gitignored — never commit real values there.
#
# Two groups below, deliberately treated differently:
# - Credentials (first block): left BLANK on purpose, even the non-secret ones (POSTGRES_HOST,
#   POSTGRES_USER, ...) — forces you to consciously type a real value, no copy-paste-and-forget
#   into a weak shared default.
# - Non-secret app config (second block): pre-filled with real, working values (what this stack
#   actually runs with) — copy as-is unless you deliberately want to tune something. No security
#   reason to leave these blank, unlike the credentials above.
#
# Changer POSTGRES_DB/POSTGRES_USER ne touche PAS la base "keycloak" (nom fixe, gérée par
# docker/postgres/init/01-create-keycloak-db.sh) — uniquement la base applicative.

POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
REDIS_PASSWORD=
QDRANT_API_KEY=

# Non-secret application config — moved here from Spring defaults (application.properties has
# none left). Still ${VAR:?}-required in docker-compose.yml (fails fast if missing).
APP_AUTO_ENABLE_NEW_USERS=false # true/false — new signups usable immediately, skipping ADMIN approval
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173 # origin(s) allowed to call this API (comma-separated), i.e. the frontend URL
APP_UPLOADS_ENABLED=true # true/false — turns the image-attachment upload feature on/off
APP_UPLOADS_MAX_SIZE_BYTES=10000000 # max size in bytes accepted for one image attachment
APP_UPLOADS_ALLOWED_TYPES=image/png,image/jpeg,image/webp # comma-separated MIME types accepted for image attachments
APP_UPLOADS_ORPHAN_TTL_HOURS=24 # hours an unattached upload survives before the retention job deletes it
APP_UPLOADS_RATE_LIMIT_PER_HOUR=30 # max image uploads a single user can make per hour
MANAGEMENT_PORT=8081 # port serving /actuator (health, prometheus) — separate from the public API port
GUARD_RPM=10 # max chat requests a single user can send per minute
GUARD_RPD=500 # max chat requests a single user can send per day
GUARD_BUDGET_GLOBAL_EUR=50 # max total LLM spend per day across every user, in EUR
GUARD_BUDGET_USER_EUR=5 # max LLM spend per day for a single user, in EUR
APP_REDIS_BUDGET_RECONCILE_MINUTES=5 # how often Redis-tracked budget counters get reconciled against the DB
APP_RAG_MAX_SIZE_BYTES=20000000 # max size in bytes accepted for one uploaded RAG document (PDF)
APP_RAG_CHUNK_CHARS=2000 # characters per text chunk when splitting a document for embedding
APP_RAG_CHUNK_OVERLAP_CHARS=300 # characters of overlap kept between two consecutive chunks
APP_RAG_MAX_EXTRACTED_CHARS=2000000 # max characters kept from a PDF's extracted text before truncating
APP_RAG_EXTRACTION_TIMEOUT_MS=30000 # max time allowed to extract text from a PDF before giving up
APP_RAG_EMBEDDING_DIMENSION=768 # vector size produced by the embedding-server's model — must match the Qdrant collection
APP_RAG_RATE_LIMIT_PER_HOUR=10 # max RAG document uploads a single user can make per hour
QDRANT_COLLECTION=rag_chunks # name of the Qdrant collection storing RAG chunk vectors
