# Root-level credentials for docker-compose.yml — REQUIRED, no weak fallback.
# docker compose reads a `.env` file in this directory automatically.
#
# `docker compose up` refuses to start without these set (fail-closed on purpose —
# a missing var used to silently fall back to postgres/postgres, admin/admin, ...).
#
# Copy this file to `.env` first:
#   cp .env.example .env
#
# The values below are convenient for local dev on localhost. Change them to real
# secrets before deploying anywhere reachable beyond localhost.
#
# `.env` is gitignored — never commit real values here.

POSTGRES_PASSWORD=postgres
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
REDIS_PASSWORD=changeme
