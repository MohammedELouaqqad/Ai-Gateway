# Root-level credentials for docker-compose.yml — REQUIRED, no weak fallback.
# docker compose reads a `.env` file in this directory automatically.
#
# `docker compose up` refuses to start without every one of these set — no default,
# no fallback anywhere in docker-compose.yml (${VAR:?} for all of them). A missing OR
# blank var used to silently fall back to postgres/postgres, admin/admin, ... not anymore.
#
# This file is the template committed to the repo. Copy it to `.env` first, THEN fill in
# every value yourself:
#   cp .env.example .env
#
# `.env` is gitignored — never commit real values there.
#
# Every value below is left BLANK on purpose, secrets and non-secret config alike — forces you
# to consciously type a real value, no copy-paste-and-forget into a hidden default. The comment
# next to each non-secret one explains what it controls, not what to put there.
#
# Changer POSTGRES_DB/POSTGRES_USER ne touche PAS la base "keycloak" (nom fixe, gérée par
# docker/postgres/init/01-create-keycloak-db.sh) — uniquement la base applicative.

POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
REDIS_PASSWORD=
QDRANT_API_KEY=

# Non-secret application config — moved here from Spring defaults (application.properties has
# none left). Still ${VAR:?}-required in docker-compose.yml (fails fast if missing).
APP_AUTO_ENABLE_NEW_USERS= # true/false — new signups usable immediately, skipping ADMIN approval
APP_CORS_ALLOWED_ORIGINS= # origin(s) allowed to call this API (comma-separated), i.e. the frontend URL
APP_UPLOADS_ENABLED= # true/false — turns the image-attachment upload feature on/off
APP_UPLOADS_MAX_SIZE_BYTES= # max size in bytes accepted for one image attachment
APP_UPLOADS_ALLOWED_TYPES= # comma-separated MIME types accepted for image attachments
APP_UPLOADS_ORPHAN_TTL_HOURS= # hours an unattached upload survives before the retention job deletes it
APP_UPLOADS_RATE_LIMIT_PER_HOUR= # max image uploads a single user can make per hour
MANAGEMENT_PORT= # port serving /actuator (health, prometheus) — separate from the public API port
GUARD_RPM= # max chat requests a single user can send per minute
GUARD_RPD= # max chat requests a single user can send per day
GUARD_BUDGET_GLOBAL_EUR= # max total LLM spend per day across every user, in EUR
GUARD_BUDGET_USER_EUR= # max LLM spend per day for a single user, in EUR
APP_REDIS_BUDGET_RECONCILE_MINUTES= # how often Redis-tracked budget counters get reconciled against the DB
APP_RAG_MAX_SIZE_BYTES= # max size in bytes accepted for one uploaded RAG document (PDF)
APP_RAG_CHUNK_CHARS= # characters per text chunk when splitting a document for embedding
APP_RAG_CHUNK_OVERLAP_CHARS= # characters of overlap kept between two consecutive chunks
APP_RAG_MAX_EXTRACTED_CHARS= # max characters kept from a PDF's extracted text before truncating
APP_RAG_EXTRACTION_TIMEOUT_MS= # max time allowed to extract text from a PDF before giving up
APP_RAG_EMBEDDING_MODEL= # Ollama model name used to turn chunks into vectors
APP_RAG_EMBEDDING_DIMENSION= # vector size produced by the embedding model — must match the Qdrant collection
APP_RAG_RATE_LIMIT_PER_HOUR= # max RAG document uploads a single user can make per hour
QDRANT_COLLECTION= # name of the Qdrant collection storing RAG chunk vectors
