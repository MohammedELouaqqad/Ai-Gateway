# Root-level credentials for docker-compose.yml — REQUIRED, no weak fallback.
# docker compose reads a `.env` file in this directory automatically.
#
# `docker compose up` refuses to start without these set (fail-closed on purpose —
# a missing OR blank var used to silently fall back to postgres/postgres, admin/admin, ...).
#
# Copy this file to `.env` first, THEN fill in real values below — leaving them blank
# still makes `docker compose up` refuse to start (same check), so there's no way to end
# up running with weak credentials just by copy-pasting without reading this file:
#   cp .env.example .env
#
# `.env` is gitignored — never commit real values here.

POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
REDIS_PASSWORD=
